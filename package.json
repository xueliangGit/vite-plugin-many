{
  "name": "vite-plugin-many",
  "version": "0.3.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index/index.d.ts",
      "import": "./dist/index/index.js",
      "require": "./dist/index/index.cjs"
    },
    "./inject": {
      "types": "./dist/inject/index.d.ts",
      "import": "./dist/inject/index.js",
      "require": "./dist/inject/index.cjs"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "import": "./dist/mock/index.js",
      "require": "./dist/mock/index.cjs"
    },
    "./middlewares": {
      "types": "./dist/middlewares/index.d.ts",
      "import": "./dist/middlewares/index.js",
      "require": "./dist/middlewares/index.cjs"
    },
    "./mini": {
      "types": "./dist/mini/index.d.ts",
      "import": "./dist/mini/index.js",
      "require": "./dist/mini/index.cjs"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js",
      "require": "./dist/input/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup "
  },
  "dependencies": {
    "fast-glob": "^3.3.1",
    "html-minifier": "^4.0.0",
    "typescript": "^5.1.3",
    "vite": "^4.3.9"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.3",
    "@types/html-minifier": "^4.0.2",
    "@types/node": "^20.5.7",
    "tsup": "^7.2.0"
  }
}